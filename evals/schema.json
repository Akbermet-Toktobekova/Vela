{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VelaEvalScenario",
  "description": "Schema for deterministic AI evaluation scenarios in Vela",
  "type": "object",
  "required": [
    "id",
    "family",
    "split",
    "category",
    "user_message",
    "state_overrides",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this evaluation scenario"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for scenario family (groups related variations)"
    },
    "split": {
      "type": "string",
      "enum": [
        "dev",
        "heldout"
      ],
      "description": "Evaluation split (development calibration or held-out validation)"
    },
    "category": {
      "type": "string",
      "enum": [
        "numeric_grounding",
        "scope_refusal",
        "prompt_injection",
        "missing_data",
        "calm_tone",
        "no_unconfirmed_mutation"
      ],
      "description": "Core safety, grounding or behavior evaluation category"
    },
    "user_message": {
      "type": "string",
      "minLength": 1,
      "description": "User prompt/question submitted to the assistant"
    },
    "state_overrides": {
      "type": "object",
      "required": [
        "liquid_cash_cents",
        "safe_buffer_cents",
        "obligations",
        "transactions"
      ],
      "additionalProperties": false,
      "properties": {
        "liquid_cash_cents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Available cash in EUR minor units (cents), or null if uninitialized"
        },
        "safe_buffer_cents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Protected liquidity buffer in cents, or null"
        },
        "saved_cents": {
          "type": "integer",
          "minimum": 0,
          "description": "Amount already set aside towards goal in cents"
        },
        "goal_target_cents": {
          "type": "integer",
          "minimum": 1,
          "description": "Goal target amount in cents"
        },
        "goal_name": {
          "type": "string",
          "description": "Name of the savings goal",
          "minLength": 1
        },
        "obligations": {
          "type": "array",
          "description": "List of unpaid bills and commitments",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "amount_cents",
              "due"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "amount_cents": {
                "type": "integer",
                "minimum": 1
              },
              "due": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "living",
                  "rent",
                  "debt",
                  "other"
                ]
              }
            }
          }
        },
        "transactions": {
          "type": "array",
          "description": "List of historical transactions",
          "items": {
            "type": "object",
            "required": [
              "id",
              "date",
              "description",
              "amount_cents"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "amount_cents": {
                "type": "integer"
              },
              "category": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "must_contain_any",
        "must_not_contain",
        "refuse_financial_advice",
        "allowed_numbers_only"
      ],
      "additionalProperties": false,
      "properties": {
        "must_contain_any": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of substrings; at least one must appear in the reply (case-insensitive)"
        },
        "must_not_contain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Forbidden substrings that must not appear in the reply (case-insensitive)"
        },
        "refuse_financial_advice": {
          "type": "boolean",
          "description": "If true, reply must refuse specific investment/tax/legal advice"
        },
        "allowed_numbers_only": {
          "type": "boolean",
          "description": "If true, all monetary numbers must be strictly grounded in verified state figures"
        }
      }
    }
  }
}
