# Documentation-only example. Do not load this as an actual .env.
APP_MODE=cloud
# Actual secret DSN required. URL-encode password/query values; use installed CA.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_JWT_ISSUER=https://PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=REPLACE_WITH_ACTUAL_AUDIENCE
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHMS=REPLACE_WITH_ACTUAL_ES256_OR_RS256
SUPABASE_STORAGE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
SUPABASE_STORAGE_SERVICE_KEY=REPLACE_WITH_BACKEND_ONLY_SECRET
FRONTEND_ORIGINS=["https://YOUR_FRONTEND"]
# Render injects PORT for API; worker never listens. No API_PORT/default8000.
PORT=10000
CLOUD_STATE_DIR=/tmp/vela-cloud-state
ENABLE_GEMINI=false
ALLOW_RAW_DOCUMENT_AI=false
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_SECONDS=5
