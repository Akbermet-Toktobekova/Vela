        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.sanatbek.velanfc",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "NFC"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "3c0a2fba-d727-42ef-a920-9bc12487fd38"
      }
    },
    "owner": "dizbalanser"
  }
}
